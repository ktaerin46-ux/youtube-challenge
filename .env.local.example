# ============================================
# 유튜브 챌린지 환경 변수 설정
# ============================================
# 이 파일을 .env.local 로 복사하고 실제 값을 입력하세요
# cp .env.local.example .env.local

# ============================================
# Supabase 설정
# Supabase 프로젝트 대시보드 → Settings → API에서 확인
# ============================================

# Supabase 프로젝트 URL (예: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Supabase anon key (공개 키 - 프론트엔드에서 사용)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service_role key (비공개 키 - 서버에서만 사용, 절대 외부 유출 금지)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================
# 관리자 인증 설정
# ============================================

# 관리자 페이지 접속 비밀번호 (최소 8자 이상 권장)
ADMIN_PASSWORD=your_strong_admin_password_here

# 관리자 토큰 서명용 비밀키 (랜덤 문자열, 최소 32자 이상 권장)
ADMIN_SECRET=your_random_secret_key_minimum_32_characters

# ============================================
# 배포 URL (Vercel 배포 시 자동 설정됨)
# ============================================
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ============================================
# 기수(코호트) 설정
# ============================================
# 이 값을 설정하지 않으면 "1기"로 동작 (이름+유튜브 채널 링크로 인증, 기존 방식 그대로)
# "1기"가 아닌 값을 넣으면 "이름+전화번호"로 인증 방식이 바뀝니다.
# 2기 사이트를 새 Vercel 프로젝트로 배포할 때만 아래처럼 설정하세요.
# NEXT_PUBLIC_COHORT=2기

# 챌린지 시작일 (설정하지 않으면 1기 시작일인 2026-06-04 사용)
# 2기는 시작일이 다르므로 2기 Vercel 프로젝트에는 반드시 설정하세요.
# NEXT_PUBLIC_CHALLENGE_START_DATE=2026-07-14

# 챌린지 전체 기간(일수) — 설정하지 않으면 4주(28일)로 계산
# 마지막 주가 온전한 7일이 아닐 때(예: 26일이면 마지막 주는 5일) 사용
# NEXT_PUBLIC_CHALLENGE_TOTAL_DAYS=26
